# Database
DATABASE_URL="file:./dev.db"

# Storage configuration: "local" (default) | "s3" | "vercel_blob"
STORAGE_PROVIDER="local"
# For S3 (if using S3 storage provider):
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# For Vercel Blob:
# BLOB_READ_WRITE_TOKEN=""

# AI Provider Configuration (OpenAI-compatible)
# ClauseLens works with any OpenAI-compatible endpoint (OpenAI, OpenRouter, Groq, Ollama, vLLM, etc.)
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
